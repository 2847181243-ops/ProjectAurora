# Module registration machinery.
#
# Adding a module is: one add_subdirectory line in Modules/CMakeLists.txt, one
# aurora_add_module() call, one manifest JSON. Nothing in the platform layer
# changes. Switching a module off is one cache option.

set(AURORA_MODULE_REGISTRY "" CACHE INTERNAL "module_id|entry_symbol pairs linked into this build")

function(aurora_add_module target module_id entry_symbol)
    cmake_parse_arguments(ARG "" "" "SOURCES" ${ARGN})
    if(NOT ARG_SOURCES)
        message(FATAL_ERROR "aurora_add_module(${target}) needs SOURCES")
    endif()
    add_library(${target} STATIC ${ARG_SOURCES})
    target_include_directories(${target} PUBLIC "${PROJECT_SOURCE_DIR}/SDK/AuroraRuntimeAPI/include")
    set_target_properties(${target} PROPERTIES POSITION_INDEPENDENT_CODE ON)
    # A module may only include the public ABI header. Anything else is a layering bug.
    target_compile_definitions(${target} PRIVATE AURORA_MODULE_ID="${module_id}")

    set_property(GLOBAL APPEND PROPERTY AURORA_MODULE_TARGETS ${target})

    set(registry "${AURORA_MODULE_REGISTRY}")
    list(APPEND registry "${module_id}|${entry_symbol}")
    set(AURORA_MODULE_REGISTRY "${registry}" CACHE INTERNAL "module_id|entry_symbol pairs linked into this build" FORCE)
endfunction()

function(aurora_emit_builtin_table out_cpp)
    set(content "/* Generated by BuildSystem/AuroraModules.cmake. Do not edit. */\n")
    string(APPEND content "#include \"aurora/builtin_modules.h\"\n\n")

    set(pairs "")
    foreach(entry IN LISTS AURORA_MODULE_REGISTRY)
        if(entry STREQUAL "")
            continue()
        endif()
        list(APPEND pairs "${entry}")
    endforeach()

    foreach(entry IN LISTS pairs)
        string(REPLACE "|" ";" parts "${entry}")
        list(GET parts 0 id)
        list(GET parts 1 symbol)
        string(APPEND content "extern \"C\" const AuroraModuleVTable* ${symbol}(void); /* ${id} */\n")
    endforeach()

    string(APPEND content "\nconst AuroraBuiltinModule aurora_builtin_modules[] = {\n")
    foreach(entry IN LISTS pairs)
        string(REPLACE "|" ";" parts "${entry}")
        list(GET parts 0 id)
        list(GET parts 1 symbol)
        string(APPEND content "    {\"${id}\", &${symbol}},\n")
    endforeach()
    string(APPEND content "};\n\n")
    string(APPEND content "const size_t aurora_builtin_module_count = sizeof(aurora_builtin_modules) / sizeof(aurora_builtin_modules[0]);\n")

    file(WRITE "${out_cpp}" "${content}")
    message(STATUS "Aurora built-in modules: ${pairs}")
endfunction()
